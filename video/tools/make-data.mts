// Runs the app's real engine and writes the film's board data to assets/game-data.js.
// One bad apple replays the exact game a first-time visitor sees (seed 0, mutation 0.1%, the default designed piece).
// Run from the repo root: node --experimental-strip-types video/tools/make-data.mts
import { writeFileSync } from 'node:fs';
import { NAMES } from '../../src/engine.ts';
import { census, kaleidoscope, moments, payoffs, scenario, scores, step, withCustom } from '../../src/evolution.ts';

const ALL = [...NAMES, 'Your piece'];
const tables = withCustom(payoffs('curiosity'), { first: 1, afterC: 0, afterD: 1, forgives: false }, 'curiosity');
const TURNS = 64;
let w = scenario('apple', '0');
const apple = { n: 48, cells: [] as string[], light: [] as string[], counts: [] as number[][] };
for (let g = 0; g <= TURNS; g++) {
  const s = scores(w, tables);
  apple.cells.push(Array.from(w.cells).join(''));
  apple.light.push(Array.from(s, x => Math.round(Math.min(1, x / 3) * 9)).join(''));
  apple.counts.push(census(w.cells));
  if (g < TURNS) w = step(w, tables, .001, `0|${g}`);
}
// shown: the first turn at which the app would list each moment (lead changes and peaks are confirmed a few turns later).
const marks = moments(apple.counts, ALL).map(m => {
  let shown = m.turn;
  while (!moments(apple.counts.slice(0, shown + 1), ALL).some(x => x.turn === m.turn && x.text === m.text)) shown++;
  return { ...m, shown };
});

const K = kaleidoscope(1.85, s => s !== 1), KT = 60;
let k = scenario('kaleido', 'k', 96), prev = k;
const kaleido = { n: 96, b: 1.85, cls: [] as string[] };
for (let g = 0; g <= KT; g++) {
  // 0 still cooperating, 1 still defecting, 2 just turned D, 3 just turned C
  kaleido.cls.push(Array.from(k.cells, (c, i) => { const now = c !== 1, was = prev.cells[i] !== 1; return now ? (was ? 0 : 3) : (was ? 2 : 1); }).join(''));
  prev = k; k = step(k, K, 0, `k|${g}`, true);
}

writeFileSync('video/assets/game-data.js', `// Generated by video/tools/make-data.mts from src/evolution.ts. Do not edit by hand.\nwindow.GT = ${JSON.stringify({ apple, marks, kaleido })};\n`);
console.log('turns', TURNS, 'moments', JSON.stringify(marks));
console.log('final counts', apple.counts[TURNS].join(' '), '| turn 14', apple.counts[14].join(' '));
